%_signature gpg
%_gpg_path /root/.gnupg
%_gpg_name bssadmin
%_gpgbin /usr/bin/gpg2
%__gpg_sign_cmd %{__gpg} gpg --force-v3-sigs --batch --verbose --pinentry-mode loopback  --passphrase-file /workspace/RPM/gpg-passphrase.txt --no-armor --no-secmem-warning -u "%{_gpg_name}" -sbo %{__signature_filename} --digest-algo sha256 %{__plaintext_filename}'